.container {
  padding: 40rpx 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ===== 三个按钮外层 ===== */
.action-wrapper {
  width: 100%;
}

/* 无扫描结果时垂直居中 */
.action-wrapper-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.action-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  width: 100%;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  text-align: center;
}

.action-btn::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.action-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.action-btn.disabled {
  opacity: 0.6;
  pointer-events: none;
}

.action-title {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.action-sub {
  font-size: 24rpx;
  opacity: 0.85;
  letter-spacing: 1rpx;
}

.action-multi {
  background: linear-gradient(135deg, #34d399, #10b981);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(16, 185, 129, 0.3);
}

.action-scan {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(59, 130, 246, 0.3);
}

.action-history {
  background: #fff;
  color: #3b82f6;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.06);
}

.action-history .action-title {
  color: #3b82f6;
}

.action-history .action-sub {
  color: #94a3b8;
  opacity: 1;
}

.tip {
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  margin: 20rpx 0 40rpx;
}

/* ===== 数据区 ===== */
.picker-area {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 30rpx 40rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-bar {
  position: relative;
  flex: 1;
  min-width: 0;
}

.search-input {
  width: 100%;
  height: 76rpx;
  background: #f8fafc;
  border-radius: 38rpx;
  padding: 0 70rpx 0 28rpx;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
  border: 2rpx solid #e2e8f0;
}

.search-clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  font-size: 30rpx;
  font-weight: bold;
}

.field-picker { flex-shrink: 0; }

.field-picker-value {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 38rpx;
  white-space: nowrap;
}

.search-result-list {
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  overflow: hidden;
}

.result-scroll { max-height: 400rpx; }

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid #e2e8f0;
  background: #fff;
}

.result-item:last-child { border-bottom: none; }

.result-item-active {
  background: #eff6ff;
  border-left: 6rpx solid #3b82f6;
}

.result-left { flex: 1; min-width: 0; }

.result-loc {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.result-spec {
  font-size: 24rpx;
  color: #94a3b8;
}

.result-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.result-qty {
  font-size: 30rpx;
  font-weight: bold;
  color: #3b82f6;
}

.tag-ok-sm {
  font-size: 20rpx;
  background: #dcfce7;
  color: #16a34a;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.tag-pending-sm {
  font-size: 20rpx;
  background: #fee2e2;
  color: #dc2626;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.tag-oos-sm {
  font-size: 20rpx;
  background: #ffedd5;
  color: #ea580c;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.no-result {
  text-align: center;
  padding: 30rpx;
  color: #94a3b8;
  font-size: 26rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.picker-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.picker-value {
  padding: 0 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.loc-text {
  font-size: 36rpx;
  color: #1e293b;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.loc-arrow {
  font-size: 28rpx;
  color: #94a3b8;
  margin-left: 12rpx;
}

.card {
  margin-top: 30rpx;
  background: linear-gradient(135deg, #fafcff, #f5f9ff);
  border-radius: 16rpx;
  padding: 24rpx 30rpx 30rpx 30rpx;
  border-left: 8rpx solid #3b82f6;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px dashed #e2e8f0;
  font-size: 30rpx;
}

.card-row .label {
  color: #94a3b8;
  font-size: 28rpx;
  flex-shrink: 0;
}

.card-row .value {
  color: #1e293b;
  font-weight: bold;
  font-size: 32rpx;
  word-break: break-all;
  text-align: right;
  max-width: 65%;
  margin-left: 20rpx;
}

.card-row .qty-text {
  color: #3b82f6;
  font-size: 36rpx;
}

.card-row .sku-text {
  font-family: Menlo, Consolas, monospace;
  font-size: 30rpx;
  color: #475569;
}

.status-row {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
}

.status-confirmed {
  color: #16a34a;
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.status-pending {
  color: #dc2626;
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.status-oos {
  color: #ea580c;
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.progress {
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  margin: 40rpx 0 30rpx 0;
}

.progress-num {
  color: #3b82f6;
  font-weight: bold;
  font-size: 32rpx;
  margin: 0 6rpx;
}

.all-done {
  text-align: center;
  color: #16a34a;
  font-size: 36rpx;
  font-weight: bold;
  margin: 20rpx 0;
  padding: 24rpx;
  background: #f0fdf4;
  border-radius: 16rpx;
  border: 2rpx dashed #16a34a;
  letter-spacing: 2rpx;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn-confirm {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
}

.btn-oos {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #fb923c, #ea580c);
  box-shadow: 0 8rpx 24rpx rgba(251, 146, 60, 0.3);
}

.btn-confirm:active,
.btn-oos:active {
  opacity: 0.85;
  transform: scale(0.98);
  transition: all 0.1s;
}

.btn-disabled {
  background: #cbd5e1 !important;
  color: #fff !important;
  box-shadow: none !important;
  pointer-events: none;
}