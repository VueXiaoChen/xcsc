.container {
  padding: 40rpx 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  text-align: center;
}

.action-btn::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.action-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.action-title {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.action-sub {
  font-size: 24rpx;
  opacity: 0.85;
  letter-spacing: 1rpx;
}

.action-multi {
  background: linear-gradient(135deg, #34d399, #10b981);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(16, 185, 129, 0.3);
}

.action-scan {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(59, 130, 246, 0.3);
}

.action-history {
  background: #fff;
  color: #3b82f6;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.06);
}

.action-history .action-title {
  color: #3b82f6;
}

.action-history .action-sub {
  color: #94a3b8;
  opacity: 1;
}