.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
}

/* 顶部统计 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.count-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.count-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #3b82f6;
  line-height: 1;
}

.count-label {
  font-size: 26rpx;
  color: #888;
}

.btn-clear {
  font-size: 26rpx;
  color: #dc2626;
  background: #fff;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  border: 1px solid #fee2e2;
}

/* 总记录入口 */
.all-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #eff6ff, #f0fdf4);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid #dbeafe;
}

.all-entry:active {
  opacity: 0.85;
}

.all-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1e40af;
  margin-bottom: 6rpx;
}

.all-sub {
  font-size: 24rpx;
  color: #64748b;
}

.all-entry .arrow {
  font-size: 44rpx;
  color: #3b82f6;
  font-weight: bold;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 160rpx 0;
}
.empty-text {
  color: #bbb;
  font-size: 28rpx;
}

/* 扫描批次卡片 */
.scan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  position: relative;
  overflow: hidden;
}

.scan-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #60a5fa, #3b82f6);
}

.scan-item:active {
  background: #f8fafc;
}

.scan-left {
  flex: 1;
  min-width: 0;
}

.scan-time {
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.scan-desc {
  font-size: 24rpx;
  color: #94a3b8;
}

.scan-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.badge-done {
  background: #dcfce7;
  color: #16a34a;
}

.badge-doing {
  background: #fef3c7;
  color: #d97706;
}

.arrow {
  font-size: 40rpx;
  color: #cbd5e1;
  font-weight: bold;
}

.hint {
  text-align: center;
  color: #cbd5e1;
  font-size: 24rpx;
  margin-top: 30rpx;
}