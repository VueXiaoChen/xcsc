<view class="container">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索库位 / 颜色尺码 / SKU"
      value="{{keyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
    />
    <view class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">×</view>
  </view>

  <!-- 统计 -->
  <view class="stat-bar">
    <view class="stat-text">
      共 <text class="num">{{filtered.length}}</text> 条
      <text class="stat-sub" wx:if="{{keyword}}">（筛选自 {{totalCount}} 条）</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{filtered.length === 0}}">
    <view class="empty-text">
      {{keyword ? '没有匹配的记录' : '还没有任何历史记录'}}
    </view>
  </view>

  <!-- 条目列表 -->
  <view class="list">
    <view class="item" wx:for="{{filtered}}" wx:key="uid">
      <view class="item-header">
        <text class="loc">{{item.location}}</text>
        <view class="{{item.confirmed ? 'tag-ok' : (item.outOfStock ? 'tag-oos' : 'tag-pending')}}">
          {{item.confirmed ? '已确认' : (item.outOfStock ? '缺货' : '待捡货')}}
        </view>
      </view>
      <view class="item-body">
        <view class="row">
          <text class="label">颜色尺码</text>
          <text class="value">{{item.spec}}</text>
        </view>
        <view class="row">
          <text class="label">数量</text>
          <text class="value qty">{{item.quantity}}</text>
        </view>
        <view class="row">
          <text class="label">SKU</text>
          <text class="value sku">{{item.sku}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ⭐ 右下角三个悬浮按钮 -->
  <view class="fab-group">
    <view class="fab fab-export" bindtap="exportHistory" wx:if="{{totalCount > 0}}">
      <view class="fab-text">导出</view>
    </view>
    <view class="fab fab-upload" bindtap="restoreHistory">
      <view class="fab-text">上传</view>
    </view>
    <view class="fab fab-delete" bindtap="deleteAll" wx:if="{{totalCount > 0}}">
      <view class="fab-text">删除</view>
    </view>
  </view>
</view>