.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
  padding-bottom: 240rpx;
}

/* ===== 上传区 ===== */
.upload-wrap { padding-top: 120rpx; }

.upload-btn {
  background: linear-gradient(135deg, #34d399, #10b981);
  color: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(16, 185, 129, 0.3);
  position: relative;
  overflow: hidden;
}

.upload-btn::after {
  content: '';
  position: absolute;
  right: -60rpx; top: -60rpx;
  width: 200rpx; height: 200rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
}

.upload-btn.disabled { opacity: 0.6; pointer-events: none; }

.upload-title {
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.upload-sub { font-size: 24rpx; opacity: 0.9; }

.tip {
  margin-top: 30rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 0 20rpx;
}

/* ===== 顶部进度 ===== */
.top-bar {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  position: relative;
}

.progress-text {
  font-size: 28rpx;
  color: #475569;
  margin-bottom: 16rpx;
  font-weight: bold;
}
.progress-text .num { color: #3b82f6; font-size: 32rpx; margin: 0 4rpx; }

.progress-bar {
  height: 16rpx;
  background: #e2e8f0;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6, #2563eb);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.reset-btn {
  position: absolute;
  right: 24rpx; top: 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 6rpx 16rpx;
  background: #f1f5f9;
  border-radius: 20rpx;
}

/* ===== 库位卡片 ===== */
.loc-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 0 30rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.loc-header {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
}

.loc-tag {
  display: inline-block;
  font-size: 22rpx;
  background: rgba(255,255,255,0.25);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.loc-name {
  font-size: 52rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.loc-summary { font-size: 24rpx; opacity: 0.9; }

/* ===== 商品块 ===== */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 0 30rpx;
}

.product-block {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 0 0 20rpx;
  border-left: 8rpx solid #3b82f6;
  overflow: hidden;
}

.product-info {
  padding: 24rpx 24rpx 20rpx;
  background: #eff6ff;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  gap: 16rpx;
}

.info-row .i-label {
  color: #64748b;
  font-size: 26rpx;
  flex-shrink: 0;
}

.info-row .i-value {
  color: #1e293b;
  font-weight: 500;
  text-align: right;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  font-size: 28rpx;
}

.info-row .i-value.sku {
  font-family: Menlo, Consolas, monospace;
  font-size: 26rpx;
  color: #1e293b;
  font-weight: bold;
}

.info-row.total-row {
  border-top: 1px dashed #cbd5e1;
  padding-top: 18rpx;
  margin-top: 8rpx;
}

.info-row .i-value.qty {
  color: #3b82f6;
  font-size: 48rpx;
  font-weight: bold;
}

/* ===== SO 竖排列表 ===== */
.so-list {
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.so-row {
  display: flex;
  align-items: center;
}

.so-label {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx 20rpx 20rpx 30rpx;
  border-radius: 16rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.15);
}

.so-text {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  text-align: left;
}

/* ⭐ 圆形数字：白底 + 双层内阴影 + 蓝色渐变数字 */
.so-circle {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ffffff, #f1f5f9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 
    0 4rpx 10rpx rgba(0,0,0,0.25),
    inset 0 -4rpx 8rpx rgba(0,0,0,0.08),
    inset 0 4rpx 6rpx rgba(255,255,255,0.9);
  border: 3rpx solid rgba(255,255,255,0.95);
}

.so-circle-num {
  font-size: 42rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  line-height: 1;
  letter-spacing: -1rpx;
}

/* SO 颜色循环 */
.so-red    { background: linear-gradient(135deg, #b91c1c, #7f1d1d); }
.so-orange { background: linear-gradient(135deg, #ea580c, #c2410c); }
.so-purple { background: linear-gradient(135deg, #7c3aed, #5b21b6); }
.so-teal   { background: linear-gradient(135deg, #0d9488, #115e59); }

/* ===== 全部完成 ===== */
.all-done {
  text-align: center;
  color: #16a34a;
  font-size: 36rpx;
  font-weight: bold;
  margin: 30rpx 0;
  padding: 30rpx;
  background: #f0fdf4;
  border-radius: 16rpx;
  border: 2rpx dashed #16a34a;
  letter-spacing: 2rpx;
}

/* ===== 底部按钮 ===== */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  display: flex;
  gap: 20rpx;
  z-index: 100;
}

.btn-oos,
.btn-confirm {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  letter-spacing: 2rpx;
}

.btn-oos {
  color: #fff;
  background: linear-gradient(135deg, #fb923c, #ea580c);
  box-shadow: 0 8rpx 24rpx rgba(251, 146, 60, 0.3);
}

.btn-confirm {
  color: #fff;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
}

.btn-oos:active,
.btn-confirm:active {
  opacity: 0.85;
  transform: scale(0.98);
  transition: all 0.1s;
}

.btn-disabled {
  background: #cbd5e1 !important;
  color: #fff !important;
  box-shadow: none !important;
  pointer-events: none;
}

/* ===== 悬浮按钮：只有文字 ===== */
.fab-thumb {
  position: fixed;
  right: 40rpx;
  bottom: 220rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  box-shadow: 0 10rpx 30rpx rgba(59, 130, 246, 0.45),
              0 4rpx 8rpx rgba(59, 130, 246, 0.25),
              inset 0 -4rpx 8rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  overflow: visible;
  border: 4rpx solid #fff;
}

.fab-thumb:active {
  transform: scale(0.9);
  transition: all 0.1s;
}

.fab-thumb-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 4rpx;
  line-height: 1;
  text-indent: 4rpx;   /* 补偿字距导致的偏移 */
}

.fab-thumb-badge {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  min-width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 10rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
  box-sizing: border-box;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 10rpx rgba(220, 38, 38, 0.5);
}

/* ===== 缩略图弹层 ===== */
.thumb-modal {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.thumb-panel {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.thumb-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1px solid #f1f5f9;
}

.thumb-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1e293b;
}

.thumb-close {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  font-size: 44rpx;
  font-weight: bold;
}

.thumb-scroll {
  flex: 1;
  max-height: 65vh;
  padding-top: 20rpx;
}

.thumb-section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #475569;
  margin: 20rpx 0 16rpx;
  letter-spacing: 1rpx;
}

.thumb-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.thumb-cell {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f1f5f9;
}

.thumb-img {
  position: absolute;
  left: 0; top: 0;
  width: 100%;
  height: 100%;
}

.thumb-tag {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  text-align: center;
  word-break: break-all;
  line-height: 1.2;
}

.thumb-tag-done {
  background: rgba(22, 163, 74, 0.85);
}

.thumb-tag-pending {
  background: rgba(220, 38, 38, 0.85);
}

.thumb-empty {
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
  padding: 80rpx 0;
}